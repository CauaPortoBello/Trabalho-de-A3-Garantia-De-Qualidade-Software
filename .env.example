# Opcional. Copie para ".env" apenas se quiser mudar algum valor padrão.
# O arquivo .env não deve ser enviado ao GitHub (já está no .gitignore).

# URL do sistema testado (padrão: https://automationintesting.online)
BASE_URL=https://automationintesting.online

# 1 = Chrome sem janela (servidor/CI); 0 = navegador visível (padrão, para a demonstração)
HEADLESS=0

# Credenciais do painel /admin usadas pelo CT08.
# Padrão no conftest.py: as credenciais PÚBLICAS de demonstração publicadas no README oficial
# (https://github.com/mwinteringham/restful-booker-platform, seção "Login").
# Preencha somente para usar outras credenciais.
ADMIN_USERNAME=
ADMIN_PASSWORD=
